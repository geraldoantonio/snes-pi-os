# snes-pi-os: Raspberry Pi 1 Model B rev 2 (BCM2835, ARM1176JZF-S, 512 MB)
# Baseado em configs/raspberrypi_defconfig do Buildroot 2025.02.19.
# Usar exatamente essa versão: o rpi-userland não existe na 2026.02+.

# Arquitetura e toolchain (iguais ao raspberrypi_defconfig)
BR2_arm=y
BR2_arm1176jzf_s=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_CCACHE=y

# Sistema
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_GENERIC_HOSTNAME="snespi"
BR2_TARGET_GENERIC_ISSUE="snes-pi-os"
# Raiz somente leitura (seguro contra desligar na tomada)
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# Sem rede: o raspberrypi_defconfig liga DHCP em eth0
BR2_SYSTEM_DHCP=""
# mdev carrega módulos (gamepads, áudio) pelo modalias
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
# Login só na serial (depuração); o tty1 é do frontend
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
# seedrng grava em /var/lib, que fica na raiz somente leitura
# BR2_PACKAGE_URANDOM_SCRIPTS is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SNESPI_PATH)/board/snespi/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SNESPI_PATH)/board/snespi/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_SNESPI_PATH)/board/snespi/post-image.sh"

# Kernel (o mesmo do raspberrypi_defconfig da 2025.02.19: Raspberry Pi 6.6.28)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,576cc10e1ed50a9eacffc7a05c796051d7343ea4)/linux-576cc10e1ed50a9eacffc7a05c796051d7343ea4.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcmrpi"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# O firmware escolhe o DTB pela revisão da placa. Alvo: Model B rev 2
# (bcm2708-rpi-b); os outros Pi 1 ficam por compatibilidade (poucos KB).
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2708-rpi-b broadcom/bcm2708-rpi-b-rev1 broadcom/bcm2708-rpi-b-plus"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Firmware
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_SNESPI_PATH)/board/snespi/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_SNESPI_PATH)/board/snespi/cmdline.txt"
# BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS is not set

# Pacotes
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# xz: os módulos do kernel vêm comprimidos (HOST_KMOD_XZ abaixo)
BR2_PACKAGE_XZ=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_RPI_USERLAND=y
# Temporário: hello_triangle valida a pilha GLES legada antes do PiSNES
BR2_PACKAGE_RPI_USERLAND_HELLO=y
BR2_PACKAGE_PISNES=y
BR2_PACKAGE_SNES_LAUNCHER=y
# Jogos de teste livres (OpenSNES, MIT) na partição ROMS
BR2_PACKAGE_SNESPI_HOMEBREW=y

# Imagem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="120M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
