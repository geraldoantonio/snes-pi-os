# Layout do cartão SD do snes-pi-os.
# A lista de arquivos da partição de boot é preenchida pelo post-image.sh.

image boot.vfat {
	vfat {
		# Rótulo que aparece no computador (sem ele, "NO NAME")
		extraargs = "-n SNES-PI-OS"
		files = {
#BOOT_FILES#
		}
	}

	size = 32M
}

# Partição de ROMs e saves (montada em /roms). O S01roms a amplia até o
# fim do cartão no primeiro boot.
image roms.vfat {
	vfat {
		extraargs = "-F 32 -n ROMS"
		files = {
#ROMS_FILES#
		}
	}

	size = 512M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition roms {
		partition-type = 0xC
		image = "roms.vfat"
	}
}
