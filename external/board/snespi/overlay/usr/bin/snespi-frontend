#!/bin/sh
# Frontend do snes-pi-os, iniciado pelo init no tty1 (respawn).
#
# Usa o launcher próprio (snespi-launcher). Para depurar com o GUI nativo
# do PiSNES, crie um arquivo vazio "usar-gui-nativo" na partição ROMS.

# O PiSNES grava SRAM e snapshots em $HOME/.snes96_snapshots, e cai se
# HOME não estiver definido. A raiz é somente leitura: HOME vai para /roms.
export HOME=/roms

# Diagnóstico em /roms/.snespi/diagnostico.txt, uma vez por boot (o init
# reinicia este script se o launcher sair; não precisa repetir). Em segundo
# plano: chamadas à GPU podem travar e nunca devem impedir o menu de abrir.
if [ ! -e /tmp/.snespi-diagnostico ]; then
	touch /tmp/.snespi-diagnostico
	/usr/bin/snespi-diagnostico </dev/null >/dev/null 2>&1 &
fi

if [ -x /usr/bin/snespi-launcher ] && [ ! -e /roms/usar-gui-nativo ]; then
	# O launcher trata sozinho a partição ausente (tela de erro e nova tentativa)
	/usr/bin/snespi-launcher
	sync
	sleep 1
	exit 0
fi

if ! mountpoint -q /roms; then
	echo "snes-pi-os: a partição de ROMs (/roms) não está montada."
	echo "Verifique o cartão SD. Nova tentativa em 10 segundos..."
	sleep 10
	exit 1
fi

# O GUI usa caminhos relativos (roms/, skins/, ./snes9x) a partir da
# pasta do próprio binário, que ele descobre por argv[0].
cd /usr/share/pisnes || exit 1
/usr/share/pisnes/snes9x.gui

# Saves já foram gravados pelo snes9x (flush no /roms); sync por garantia
sync
sleep 1
